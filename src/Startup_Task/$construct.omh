Calculate $libs.$name as "svgthemer1"

Do lStringTable.$define(STRINGID,en_gb,it_it)
Do lStringTable.$add('window_title','SVG Themer','SVG Themer')
Do lStringTable.$add('open','Open SVG…','Apri SVG…')
Do lStringTable.$add('menu_open','Open','Apri')
Do lStringTable.$add('export','Export SVG…','Esporta SVG…')
Do lStringTable.$add('color','Color:','Colore:')
Do lStringTable.$add('svg_output','Processed SVG','SVG elaborato')
Do lStringTable.$add('preview','Preview: 96 · 72 · 32 · 24 · 16 px','Anteprima: 96 · 72 · 32 · 24 · 16 px')
Do lStringTable.$add('drop','Open an SVG file or drop it here. Only one icon is processed at a time.','Apri un file SVG oppure trascinalo qui. Viene elaborata una sola icona alla volta.')
Do lStringTable.$add('remove','Remove','Rimuovi')
Do lStringTable.$add('remove_declaration','Remove color declaration','Rimuovi la dichiarazione di colore')
Do lStringTable.$add('dynamic_fill','Dynamic fill color','Colore dinamico fill')
Do lStringTable.$add('dynamic_stroke','Dynamic stroke color','Colore dinamico stroke')
Do lStringTable.$add('red','Red','Rosso')
Do lStringTable.$add('blue','Blue','Blu')
Do lStringTable.$add('green','Green','Verde')
Do lStringTable.$add('purple','Purple','Viola')
Do lStringTable.$add('black','Black','Nero')
Do lStringTable.$add('gray','Gray','Grigio')
Do lStringTable.$add('status_ready','Select or drop an SVG file to begin.','Seleziona o trascina un file SVG per iniziare.')
Do lStringTable.$add('status_svg_required','Select a file with the .svg extension.','Seleziona un file con estensione .svg.')
Do lStringTable.$add('status_open_error','Unable to open file: ','Impossibile aprire il file: ')
Do lStringTable.$add('status_read_error','Unable to read file: ','Impossibile leggere il file: ')
Do lStringTable.$add('status_invalid_svg','Invalid SVG: ','SVG non valido: ')
Do lStringTable.$add('status_loaded','SVG processed. Choose colors to remove and theme options.','SVG elaborato. Scegli i colori da rimuovere e le opzioni del tema.')
Do lStringTable.$add('status_create_error','Unable to create file: ','Impossibile creare il file: ')
Do lStringTable.$add('status_exported','SVG exported: ','SVG esportato: ')
Do lStringTable.$add('status_export_error','Export failed: ','Esportazione non riuscita: ')
Do lStringTable.$add('status_drop','Drop an SVG file from your computer.','Trascina un file SVG dal sistema.')
Do StringTable.$loadtablefromlist('wIconThemer','',lStringTable)
If low(left($root.$prefs.$language,2))='it'
	Do StringTable.$setcolumn('wIconThemer.it_it')
Else
	Do StringTable.$setcolumn('wIconThemer.en_gb')
End If

Do $menus.mnuThemer.$openonce('MnuThemer')