Calculate red as mod(iPreviewColor,256)
Calculate green as mod(int(iPreviewColor/256),256)
Calculate blue as mod(int(iPreviewColor/65536),256)
Calculate colorCSS as con('rgb(',red,',',green,',',blue,')')
Calculate html as con('<!doctype html><html><head><meta charset="utf-8"><style>body{margin:0;padding:12px;font-family:system-ui;background:#f5f6f8;color:#333;display:flex;align-items:flex-start;gap:24px;--om-tint-color:',colorCSS,'}.tile{text-align:center}.icon{display:flex;align-items:center;justify-content:center;width:110px;height:100px;background:white;border-radius:6px}.icon svg{width:var(--size)!important;height:var(--size)!important;max-width:100%;max-height:100%}.size{font-size:12px;margin-top:8px}</style></head><body>')
If iLoaded
	Calculate svg as iXML
	If left(svg,5)='<?xml'
		Calculate endDecl as pos('?>',svg)
		If endDecl>0
			Calculate svg as mid(svg,endDecl+2)
		End If
	End If
	For index from 1 to 5 step 1
		Calculate size as pick(index-1,96,72,32,24,16)
		Calculate html as con(html,'<div class="tile"><div class="icon" style="--size:',size,'px">',svg,'</div><div class="size">',size,' px</div></div>')
	End For
Else
	Calculate html as con(html,'<p>Carica un SVG per visualizzare l’anteprima.</p>')
End If
Calculate html as con(html,'</body></html>')
Do $cinst.$objs.preview.$setdataurl(html,'text/html')